# Google OAuth 2.0 credentials
GOOGLE_CLIENT_ID=twoj-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=twoj-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/auth/google/callback

# Session secret (wygeneruj losowy ciąg znaków)
SESSION_SECRET=super-tajny-klucz-sesji-zmien-to

# Frontend URL
CLIENT_URL=http://localhost:3000

# Server port
PORT=5000

# Google Drive folder name (automatycznie tworzony)
DRIVE_FOLDER_NAME=DziennikRodzinny

# YouTube - handle kanału (bez @)
YOUTUBE_CHANNEL_HANDLE=@PUCZATOR
